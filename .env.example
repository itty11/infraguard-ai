# Copy to .env (docker compose reads it). Everything is optional for local runs.
DATABASE_URL=postgresql+psycopg2://infraguard:infraguard@db:5432/infraguard
API_KEY=
ACTIVE_MODEL=isolation_forest        # static_threshold | zscore_baseline | isolation_forest | autoencoder
EMBEDDING_BACKEND=tfidf              # tfidf | sbert
ANTHROPIC_API_KEY=                   # empty => extractive (no-LLM) assistant answers
LLM_MODEL=claude-sonnet-5-5
